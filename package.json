{
  "name": "wow-platform",
  "version": "0.0.0",
  "private": true,
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "playwright": "^1.64.1"
  },
  "scripts": {
    "lint": "eslint apps packages",
    "typecheck": "node scripts/validate-integration-routes.cjs && pnpm --filter @wow/api typecheck && pnpm --filter customer exec tsc --noEmit && pnpm --filter merchant exec tsc --noEmit && pnpm --filter admin exec tsc --noEmit",
    "test:query": "node scripts/test-query.cjs",
    "test:integration": "node scripts/test-integration.cjs",
    "test:customer-complaint": "node scripts/test-customer-complaint.cjs",
    "test:customer-my-complaints": "node scripts/test-customer-my-complaints.cjs",
    "test:customer-complaint-details": "node scripts/test-customer-complaint-details.cjs",
    "test:customer-business-details": "node scripts/test-customer-business-details.cjs",
    "test:customer-favorites": "node scripts/test-customer-favorites.cjs",
    "test:customer-discovery": "node scripts/test-customer-discovery.cjs",
    "test:customer-auth-completion": "node scripts/test-customer-auth-completion.cjs",
    "test:customer-offer-ratings": "node scripts/test-customer-offer-ratings.cjs",
    "validate:routes": "node scripts/validate-integration-routes.cjs"
  }
}
